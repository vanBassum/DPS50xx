# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size and speed
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# HTTP server WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# Increase timer task stack (default 2048 too small for WiFi calls in timer callbacks)
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# FAT long filename support (needed for React build output)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# OTA rollback — pairs with esp_ota_mark_app_valid_cancel_rollback() in main.cpp
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Dynamic frequency scaling: DELIBERATELY NOT ENABLED in this fork.
#
# Upstream's sdkconfig.defaults turns on CONFIG_PM_ENABLE + CONFIG_PM_DFS_INIT_AUTO,
# which lets the CPU idle down to the XTAL frequency. This fork does not take it, and
# the reason is the relay: `wss://` is TLS, so every command that arrives down the
# relay pipe costs a software crypto pass on top of the JSON, where a command from a
# browser on the LAN costs neither. On a downclocked C3 that is paid per request, and
# it presents as a UI whose pages appear instantly and whose DATA crawls -- but only
# through the relay, which is what made it look like a transport problem.
#
# A bench supply is mains-powered and its job is to answer promptly. If a
# battery-powered fork ever wants the saving back, it should measure relay command
# latency at 40 MHz first, and read docs/reasoning/2026-09-02-15h52 (from Strux) for
# why tickless idle is not the free prerequisite it looks like.
#
# Left as two comments rather than `CONFIG_PM_ENABLE=n`: a disabled bool is written to
# the generated sdkconfig as `# CONFIG_PM_ENABLE is not set`, which the drift guard in
# the root CMakeLists.txt would read as a mismatch against an `=n` assertion here.

# lwIP socket budget, and the reason it cannot stay at IDF's default of 10.
#
# esp_http_server reserves 3 sockets for itself on top of `max_open_sockets`, whose
# default is 7, and it refuses to start if LWIP_MAX_SOCKETS < max_open_sockets + 3.
# At the default of 10 that inequality is exactly tight: the web server is entitled
# to the WHOLE budget, and every other socket on the device — the relay's outbound
# WebSocket, mDNS, SNTP, the DHCP client — is competing for sockets httpd has already
# claimed. `accept()` then fails with errno 23 (ENFILE) and the server RESETS whichever
# connections lose the race.
#
# That stayed invisible while a page load asked for two files. It stopped being
# invisible when UI modules put an import map in index.html: four concurrent requests
# plus the command WebSocket, and the browser silently lost the stylesheet, so the
# device's own shell came up with no CSS at all. Nothing in the UI could say why —
# the only evidence was `httpd_accept_conn: error in accept (23)` in the device log.
#
# 16 is the option's maximum. httpd's 7 + 3 leaves six for everything else, which is
# headroom rather than a fit. The frontend also stopped asking for four files at once
# (see frontend/vite.config.ts, modulePreload) — both halves of that were wrong, and a
# fork that adds a second listener should read this before trusting the default again.
CONFIG_LWIP_MAX_SOCKETS=16
